{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local development has no Paystack credentials, so allow activating a plan directly
  // from the checkout screen to exercise Free / Standard / Premium end to end.
  "Billing": {
    "AllowDevActivation": true
  },
  "Paystack": {
    "CallbackUrl": "http://localhost:4200/payment/callback"
  }
}
