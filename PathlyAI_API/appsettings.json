{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Left empty on purpose — the real connection string is supplied at runtime via the
    // ConnectionStrings__PathlyConnection environment variable, which overrides this file and
    // keeps the secret out of source control.
    "PathlyConnection": ""
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200",
      "http://localhost:4300",
      "https://pathly-ai.netlify.app"
    ]
  },
  //"ConnectionStrings": {
  //  "PathlyConnection": "Server=.;Database=pathlyDB;Trusted_Connection=True;Encrypt=False"
  //},

  "Groq": {
    "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
    "GroqApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "FallbackKeys": [
      {
        "Name": "EduHubGroq",
        "GroqApiKey": "",
        "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
        "Model": "openai/gpt-oss-120b"
      },
      {
        "Name": "PahtlyGroq",
        "GroqApiKey": "",
        "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
        "Model": "openai/gpt-oss-120b"
      }
    ]
  },

  "Paystack": {
    "BaseUrl": "https://api.paystack.co",
    "SecretKey": "",
    // SPA route that confirms the charge and shows the upgraded plan.
    "CallbackUrl": "https://pathly-ai.netlify.app/payment/callback",
    // Optional Paystack recurring-plan codes per catalogue plan code. Without one, a
    // recurring plan is charged once and will not auto-renew.
    "PlanCodes": {}
  },

  // Development-only escape hatch. Must stay false in production.
  "Billing": {
    "AllowDevActivation": false
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "PathlyAI",
    "EnableSsl": true
  },

  "App": {
    "FrontendBaseUrl": "https://pathly-ai.netlify.app",
    "TermsVersion": "2026-01"
  },

  "Auth": {
    "RequireConfirmedEmail": false,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    "UseRefreshTokenCookie": true
  },

  // Cloudflare Turnstile bot protection. Set Enabled=true and supply real keys in production
  // (secret key via environment variable Turnstile__SecretKey). Disabled = verification skipped.
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": "",
    "Enabled": false
  },

  "Jwt": {
    "Key": "",
    "Issuer": "PathlyAI_API",
    "Audience": "PathlyAI_API"
  }
}
